@model EmployeeListViewModel
@{
    ViewData["Title"] = "社員一覧";
}
<h2>@ViewData["Title"]</h2>

@* 事前実装: チャレンジ未実装機能 (編集/削除) を実行した際の案内メッセージ表示 *@
@if (TempData["ChallengeMessage"] is string challengeMessage && !string.IsNullOrEmpty(challengeMessage))
{
    <div class="alert alert-info">@challengeMessage</div>
}

@* TODO: T-14C [チャレンジ] 新規登録リンク [Tag: User.IsInRole / asp-action]
   → 詳細設計書 §12.2.2 / §13.2 *@
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn-link">新規登録</a>
    </p>
}


@* TODO: T-14 [課題] 検索フォーム [Tag: asp-action / asp-for]
   T-14C [チャレンジ] 部署ドロップダウン [Tag: asp-items]
   → 詳細設計書 §12.2.2 / §13.1 / §13.2 *@
<form method="get" asp-action="Index" class="search-form">
    <div>
        <label asp-for="EmpName"></label>
        <input asp-for="EmpName"/>
    </div>
    <div>
        <label asp-for="DeptId"></label>
        <select asp-for="DeptId" asp-items="Model.Departments"></select>
    </div>
    <div>
        <input type="hidden" name="page" value="1" />
        <button type="submit">検索</button>
    </div>
</form>

@* TODO: T-14 [課題] 一覧テーブル [Tag: @foreach / asp-action / asp-route-id]
   T-14C [チャレンジ] Admin 限定 編集/削除リンク [Tag: User.IsInRole]
   → 詳細設計書 §12.2.2 / §13.1 / §13.2 *@
<table class="simple-table">
    <thead>
        <tr>
            <th>社員ID</th>
            <th>氏名</th>
            <th>性別</th>
            <th>生年月日</th>
            <th>部署</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model.Items)
        {
            <tr>
                <td>@item.EmpId</td>
                <td>@item.EmpName</td>
                <td>@(item.Gender == 1 ? "男" : "女")</td>
                <td>@item.Birthday.ToString("yyyy-MM-dd")</td>
                <td>@item.DeptName</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.EmpId">
                        詳細
                    </a>
                    <span>|</span>
                        <a asp-action="Edit"
                           asp-route-id="@item.EmpId">
                            編集
                        </a>
                    <span>|</span>
                        <a asp-action="Delete"
                           asp-route-id="@item.EmpId">
                            削除
                        </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@* TODO: T-14C [チャレンジ] ページャ [Tag: Model.Items.PageCount / asp-route-* / HasPreviousPage / HasNextPage]
   → 詳細設計書 §12.2.2 / §13.2 *@


@if (Model.Items.HasPreviousPage)
{
    <a asp-action="Index" asp-route-page="@(Model.Items.PageCount - 1)">前へ</a>
}
@for (int i = 1; i <= Model.Items.PageCount; i++)
{
    <a asp-action="Index" asp-route-page="@i">@i</a>
}
@if (Model.Items.HasNextPage)
{
    <a asp-action="Index" asp-route-page="@(Model.Items.PageNumber +1)">次へ</a>
}

