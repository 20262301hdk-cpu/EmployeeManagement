    <thead>
        <tr>
            <th>社員ID</th>
            <th>氏名</th>
            <th>性別</th>
            <th>生年月日</th>
            <th>部署</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

