@model EmployeeFormViewModel
@{
    ViewData["Title"] = "社員編集 - 入力";
    var birthdayValue = Model.Birthday == default ? "" : Model.Birthday.ToString("yyyy-MM-dd");
}
<h2>社員編集 - 入力</h2>

<div class="alert alert-info">
    本機能は <strong>チャレンジ課題 (T-13C / T-09C)</strong> です。
    <code>Views/Employees/Edit.cshtml</code> の <code>@* ... *@</code> を解除し、
    <code>Controllers/EmployeesController.cs</code> の T-09C と合わせて実装してください。
</div>
<p><a asp-action="Index">一覧へ戻る</a></p>

@* TODO: T-13C [チャレンジ] 編集の入力フォーム [Tag: asp-action / asp-route-id / asp-validation-summary / asp-for (hidden EmpId 含む) / asp-validation-for / asp-items]
   → 詳細設計書 §12.2.1 / §13.2
   下記ブロックを解除して実装する。
*@
<form asp-action="Edit" asp-route-id="@Model.EmpId" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="EmpId" />
    <div>
        <label>社員ID</label>
        <span>@Model.EmpId</span>
    </div>
    <div>
        @*<label>氏名</label>*@
        <label asp-for="EmpName"></label>
        <input asp-for="EmpName" />
        <span asp-validation-for="EmpName" class="text-danger"></span>
    </div>
    <div>
        @*<label>メールアドレス</label>*@
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Password"></label>
        <small>空欄なら変更しません。</small><br />
        <input asp-for="Password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <div>
        @*<label>性別</label>*@
        <label asp-for="Gender"></label>
        <input type="radio" asp-for="Gender" value="1" /> 男<br />
        <input type="radio" asp-for="Gender" value="2" /> 女
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
    <div>
        @*<label>住所</label>*@
        <label asp-for="Address"></label>
        <input asp-for="Address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div>
        @*<label>生年月日</label>*@
        <label asp-for="Birthday"></label>
        <input asp-for="Birthday" type="date" />
        <span asp-validation-for="Birthday" class="text-danger"></span>
    </div>
    <div>
        @*<label>ロール</label>*@
        <label asp-for="Role"></label>
        <input type="radio" asp-for="Role" value="User" /> User<br />
        <input type="radio" asp-for="Role" value="Admin" /> Admin
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>
    <div>
        @*<label>部署</label>*@
        <label asp-for="DeptId"></label>
        <select asp-for="DeptId" asp-items="Model.Departments"></select>
        <span asp-validation-for="DeptId" class="text-danger"></span>
    </div>
    <div class="button-row">
        <button type="submit">確認</button>
        <button type="submit">キャンセル</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
